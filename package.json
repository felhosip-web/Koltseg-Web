{
  "name": "react-example",
  "private": true,
  "version": "7.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/copy-dist.js",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dexie": "^4.4.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^1.32.0",
    "motion": "^12.23.24",
    "playwright-core": "^1.62.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "web-push": "^3.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.2.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
