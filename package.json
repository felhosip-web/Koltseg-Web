  "main": "index.html",
  "type": "module",
  "scripts": {
    "start": "echo 'Nyisd meg az index.html-t a böngészőben'",
    "dev": "echo 'Fejlesztés: használj Live Server-t vagy hasonlót'",
    
    "build": "node scripts/build.js patch",
    "build:minor": "node scripts/build.js minor",
    "build:major": "node scripts/build.js major",
    "release": "node scripts/build.js patch --changelog 'Új kiadás'",
    
    "version": "node scripts/build.js patch",
    "version:minor": "node scripts/build.js minor",
    "version:major": "node scripts/build.js major",
    
    "test": "echo 'Nincsenek tesztek még'",
