{
  "name": "react-example",
  "private": true,
  "version": "7.2.1",
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/*.test.jsx",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/copy-dist.js",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.4",
    "dexie": "^4.4.6",
    "dotenv": "^18.0.0",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "lucide-react": "^1.47.0",
    "motion": "^12.23.24",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "react": "^19.0.1",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.3",
    "web-push": "^3.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "lighthouse": "^13.4.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3"
  }
}
